{
  "compilerOptions": {
    "module": "commonjs", "target": "ES2021", "outDir": "./dist", "rootDir": "./src",
    "strict": true, "strictPropertyInitialization": false, "esModuleInterop": true,
    "emitDecoratorMetadata": true, "experimentalDecorators": true, "skipLibCheck": true,
    "declaration": false, "sourceMap": false
  },
  "include": ["src"]
}
