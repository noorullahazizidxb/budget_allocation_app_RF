# sqlite | neon (postgresql) | turso | mysql
DB_PROVIDER=sqlite
# sqlite:  file:./dev.db
# neon:    postgresql://USER:PASSWORD@ep-xxx.neon.tech/neondb?sslmode=require
# mysql:   mysql://USER:PASSWORD@HOST:3306/DB   (e.g. a free Aiven / FreeSQLDatabase / TiDB Serverless instance)
# turso:   keep file:./dev.db here (used only by Prisma CLI) and set TURSO_* below
DATABASE_URL=file:./dev.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=4000
CORS_ORIGIN=http://localhost:5173
