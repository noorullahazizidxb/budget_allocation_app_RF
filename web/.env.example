# Optional: API base URL. Defaults to /api (same origin; Vite dev server proxies to localhost:4000).
VITE_API_URL=
# reCAPTCHA v3 site key (REACT_APP_ prefix also accepted)
VITE_RECAPTCHA_SITE_KEY=

# Sentry (values are set in Vercel; do not commit secrets)
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
